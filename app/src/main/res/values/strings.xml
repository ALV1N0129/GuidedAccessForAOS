<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">사용법 유도</string>
    <string name="service_label">사용법 유도</string>
    <string name="service_description">한 개의 앱에서만 기기를 사용하도록 제한합니다. 다른 앱으로 나가는 것을 막고, 지정한 화면 영역의 터치와 볼륨 버튼을 차단하며, 시간 제한을 걸 수 있습니다. 볼륨 내리기 버튼을 빠르게 세 번 누르면 시작/종료할 수 있습니다. 이 서비스는 화면 내용을 읽지 않으며, 현재 실행 중인 앱의 이름과 볼륨 버튼 입력만 사용합니다.</string>

    <!-- 공통 -->
    <string name="cancel">취소</string>
    <string name="start">시작</string>
    <string name="end">종료</string>
    <string name="resume">재개</string>
    <string name="ok">확인</string>

    <!-- 영역 편집 오버레이 -->
    <string name="setup_hint">차단할 영역을 손가락으로 드래그해서 지정하세요.\n빨간 ×: 삭제 · 흰 점: 크기 조절 · 영역 드래그: 이동</string>
    <string name="setup_hint_touch_off">터치가 꺼져 있어 화면 전체가 차단됩니다.</string>
    <string name="options">옵션</string>
    <string name="options_close">옵션 닫기</string>
    <string name="opt_touch">터치</string>
    <string name="opt_volume">볼륨 버튼</string>
    <string name="opt_time_limit">시간 제한</string>
    <string name="opt_clear_areas">영역 모두 지우기</string>
    <string name="time_none">없음</string>
    <string name="time_minutes">%d분</string>
    <string name="time_hours">%d시간</string>
    <string name="time_hours_minutes">%1$d시간 %2$d분</string>

    <!-- 암호 오버레이 -->
    <string name="pin_enter">암호 입력</string>
    <string name="pin_enter_message">사용법 유도를 종료하거나 옵션을 바꾸려면 암호를 입력하세요.</string>
    <string name="pin_new">새 암호 설정</string>
    <string name="pin_new_message">사용법 유도를 종료할 때 사용할 4~8자리 숫자를 입력하세요.</string>
    <string name="pin_confirm">암호 확인</string>
    <string name="pin_confirm_message">같은 암호를 한 번 더 입력하세요.</string>
    <string name="pin_mismatch">암호가 일치하지 않습니다. 처음부터 다시 입력하세요.</string>
    <string name="pin_wrong">암호가 올바르지 않습니다. (%1$d/%2$d)</string>
    <string name="pin_locked">너무 많이 틀렸습니다. %d초 후에 다시 시도하세요.</string>
    <string name="pin_too_short">4자리 이상 입력하세요.</string>

    <!-- 차단/시간 종료 화면 -->
    <string name="shield_title">사용법 유도 사용 중</string>
    <string name="shield_message">이 기기는 현재 한 개의 앱만 사용할 수 있습니다.\n잠시 후 앱으로 돌아갑니다.</string>
    <string name="exit_hint">종료하려면 볼륨 내리기 버튼을 빠르게 세 번 누르세요.</string>
    <string name="time_up_title">시간 종료</string>
    <string name="time_up_message">설정한 사용 시간이 끝났습니다.</string>
    <string name="time_up_button">암호 입력</string>

    <!-- 토스트 -->
    <string name="toast_started">사용법 유도가 시작되었습니다</string>
    <string name="toast_ended">사용법 유도가 종료되었습니다</string>
    <string name="toast_open_app_first">사용법 유도를 사용할 앱을 먼저 연 다음, 볼륨 내리기 버튼을 세 번 누르세요</string>
    <string name="toast_one_minute_left">사용 시간이 1분 남았습니다</string>

    <!-- 메인 화면 -->
    <string name="main_subtitle">iOS의 \'사용법 유도(Guided Access)\'처럼 기기를 한 개의 앱에 고정합니다.</string>
    <string name="card_service">1. 접근성 서비스</string>
    <string name="service_on">✅ 켜져 있음</string>
    <string name="service_off">⚠️ 꺼져 있음 — 아래 버튼을 눌러 \'설치된 앱 &gt; 사용법 유도\'를 켜세요.</string>
    <string name="btn_open_accessibility">접근성 설정 열기</string>
    <string name="restricted_hint">켤 수 없다고 나오면(Android 13 이상 \'제한된 설정\'): 앱 정보 &gt; 오른쪽 위 ⋮ &gt; \'제한된 설정 허용\'을 누른 뒤 다시 시도하세요.</string>
    <string name="btn_app_info">앱 정보 열기</string>
    <string name="card_pin">2. 암호</string>
    <string name="pin_set">✅ 암호가 설정되어 있습니다.</string>
    <string name="pin_not_set">암호가 없습니다. 처음 시작할 때 설정하거나 지금 설정하세요.</string>
    <string name="btn_set_pin">암호 설정</string>
    <string name="btn_change_pin">암호 변경</string>
    <string name="dialog_current_pin">현재 암호</string>
    <string name="dialog_new_pin">새 암호 (4~8자리 숫자)</string>
    <string name="dialog_confirm_pin">새 암호 확인</string>
    <string name="toast_pin_saved">암호가 저장되었습니다</string>
    <string name="toast_pin_wrong">암호가 올바르지 않습니다</string>
    <string name="toast_pin_mismatch">암호가 일치하지 않습니다</string>
    <string name="card_start">3. 시작하기</string>
    <string name="btn_pick_app">앱 선택해서 시작</string>
    <string name="start_hint">또는 사용할 앱을 연 상태에서 볼륨 내리기 버튼을 빠르게 세 번 누르세요. (접근성 버튼/단축키에도 연결됩니다)</string>
    <string name="dialog_pick_app">사용법 유도를 사용할 앱</string>
    <string name="dialog_service_needed">먼저 접근성 서비스에서 \'사용법 유도\'를 켜야 합니다.</string>
    <string name="loading_apps">앱 목록을 불러오는 중…</string>
    <string name="card_settings">4. 설정</string>
    <string name="sw_triple_click">볼륨 내리기 3번으로 시작</string>
    <string name="sw_triple_click_desc">꺼도 사용 중에는 세 번 눌러 종료할 수 있습니다.</string>
    <string name="sw_keep_after_reboot">재시작 후에도 유지</string>
    <string name="sw_keep_after_reboot_desc">끄면 iOS처럼 기기를 재시작했을 때 사용법 유도가 해제됩니다.</string>
    <string name="sw_strong_lock">강력 잠금 (기기 소유자 모드)</string>
    <string name="strong_lock_owner">✅ 이 앱이 기기 소유자입니다. 사용 중에는 홈·최근 앱·알림창이 시스템 수준에서 잠깁니다.</string>
    <string name="strong_lock_not_owner">기기 소유자가 아니면 \'돌아오기\' 방식으로 동작합니다. 완전 잠금을 원하면 PC에서 다음 명령을 실행하세요(기기에 계정이 없어야 함):\nadb shell dpm set-device-owner com.guidedaccess.aos/.AdminReceiver</string>
    <string name="btn_clear_owner">기기 소유자 해제</string>
    <string name="dialog_clear_owner">기기 소유자 권한을 해제할까요? 해제 후에는 앱을 삭제할 수 있지만, 다시 지정하려면 기기 초기화가 필요할 수 있습니다.</string>
    <string name="card_howto">사용 방법</string>
    <string name="howto">1. 접근성 서비스를 켭니다.\n2. 사용할 앱을 열고 볼륨 내리기 버튼을 빠르게 세 번 누릅니다. (또는 위 \'앱 선택해서 시작\')\n3. 화면에서 터치를 막을 영역을 드래그해서 지정합니다.\n4. \'옵션\'에서 터치 전체 차단, 볼륨 버튼, 시간 제한을 설정합니다.\n5. \'시작\'을 누릅니다. 처음이라면 암호를 설정합니다.\n\n종료: 볼륨 내리기 버튼을 세 번 → 암호 입력 → \'종료\'.\n지정한 영역과 옵션은 앱마다 저장됩니다.\n\n암호를 잊었다면: 안전 모드로 부팅하면 이 서비스가 꺼집니다.</string>
</resources>
